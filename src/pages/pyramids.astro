---
import BaseLayout from "@/layouts/BaseLayout.astro";

function chanceClasses(chance: string) {
  const percentage = Number.parseInt(chance, 10);
  if (percentage <= 5) return "border-red-500/30 bg-red-500/10 text-red-300";
  if (percentage <= 20) return "border-orange-500/30 bg-orange-500/10 text-orange-300";
  if (percentage <= 35) return "border-yellow-500/30 bg-yellow-500/10 text-yellow-300";
  return "border-green-500/30 bg-green-500/10 text-green-300";
}

const mainPyramids = [
  {
    name: "Basic Pyramid",
    image: "/pyramids/basic.webp",
    chance: "40%",
    boost: "2×",
    rewardLabel: "Coin",
    reward: "1×",
    blocks: "171,700",
    price: "N/A",
  },
  {
    name: "Silver Pyramid",
    image: "/pyramids/silver.webp",
    chance: "35%",
    boost: "3×",
    rewardLabel: "Coin",
    reward: "1.5×",
    blocks: "240,464",
    price: "117 Robux",
  },
  {
    name: "Gold Pyramid",
    image: "/pyramids/gold.webp",
    chance: "20%",
    boost: "5×",
    rewardLabel: "Coin",
    reward: "2×",
    blocks: "357,760",
    price: "225 Robux",
  },
  {
    name: "Void Pyramid",
    image: "/pyramids/void.webp",
    chance: "5%",
    boost: "10×",
    rewardLabel: "Coin",
    reward: "4×",
    blocks: "573,800",
    price: "630 Robux",
  },
];

const halloweenPyramids = [
  {
    name: "Haunted Pyramid",
    image: "/pyramids/haunted.webp",
    chance: "80%",
    boost: "10×",
    rewardLabel: "Candy Corn reward",
    reward: "1×",
    blocks: "1,002,000",
    price: "N/A",
  },
  {
    name: "Cursed Pyramid",
    image: "/pyramids/cursed.webp",
    chance: "20%",
    boost: "25×",
    rewardLabel: "Candy Corn reward",
    reward: "2×",
    blocks: "3,030,000",
    price: "249 Robux",
  },
  {
    name: "Demon Lords Castle",
    image: "/pyramids/demon-lords-castle.png",
    chance: "5%",
    boost: "50×",
    rewardLabel: "Candy Corn reward",
    reward: "4×",
    blocks: "9,980,000",
    price: "699 Robux",
  },
];
---

<BaseLayout
  title="Pyramids"
  section="Pyramids"
  description="Pyramid types, selection chances, Waters of Nu boosts, rewards, block requirements, and pick prices in Build the Pyramid."
>
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-10 px-4 py-8">
    <header class="flex flex-col gap-3">
    </header>

    <section id="main-world" class="scroll-mt-6 flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <h2 class="text-2xl font-semibold tracking-tight text-foreground">Main World</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {mainPyramids.map((pyramid) => (
          <article class="flex min-w-0 flex-col overflow-hidden rounded-xl border border-border bg-surface-lowest">
            <div class="flex h-48 items-center justify-center border-b border-border bg-black/20 p-4">
              <img src={pyramid.image} alt={pyramid.name} loading="lazy" class="h-full w-full object-contain" />
            </div>
            <div class="flex flex-1 flex-col gap-4 p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold text-foreground">{pyramid.name}</h3>
                <span class={`shrink-0 rounded-full border px-2.5 py-1 text-xs font-medium ${chanceClasses(pyramid.chance)}`}><span class="number-animation" data-target={pyramid.chance} data-animation="scramble">{pyramid.chance}</span> chance</span>
              </div>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                <div class="rounded-lg border border-border bg-background/50 p-3">
                  <div class="mb-1 flex items-center gap-1.5 text-xs text-muted-foreground"><img src="/stats/speed.png" alt="" class="h-4 w-4 object-contain" /><img src="/stats/strength.png" alt="" class="h-4 w-4 object-contain" />Waters of Nu</div>
                  <div class="text-base font-semibold text-foreground"><span class="number-animation" data-target={pyramid.boost} data-animation="scramble">{pyramid.boost}</span></div>
                  <div class="text-[11px] text-muted-foreground">Training Boost</div>
                </div>
                <div class="rounded-lg border border-border bg-background/50 p-3">
                  <div class="mb-1 flex items-center gap-1.5 text-xs text-muted-foreground"><img src="/currency/coins.png" alt="" class="h-4 w-4 object-contain" />{pyramid.rewardLabel}</div>
                  <div class="text-base font-semibold text-foreground"><span class="number-animation" data-target={pyramid.reward} data-animation="scramble">{pyramid.reward}</span></div>
                  <div class="text-[11px] text-muted-foreground">Reward Multiplier</div>
                </div>
                <div class="rounded-lg border border-border bg-background/50 p-3">
                  <div class="mb-1 text-xs text-muted-foreground">Blocks</div>
                  <div class="text-base font-semibold tabular-nums text-foreground"><span class="number-animation" data-target={pyramid.blocks} data-animation="count">{pyramid.blocks}</span></div>
                  <div class="text-[11px] text-muted-foreground">Required</div>
                </div>
              </div>
              <div class="flex items-center justify-between border-t border-border pt-3 text-sm">
                <span class="text-muted-foreground">Pick price</span>
                <span class="font-semibold text-foreground">{pyramid.price === "N/A" ? "N/A" : <span class="number-animation" data-target={pyramid.price} data-animation="scramble">{pyramid.price}</span>}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="halloween-world" class="scroll-mt-6 flex flex-col gap-5">
      <div class="flex flex-col gap-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-2xl font-semibold tracking-tight text-foreground">Halloween World</h2>
          <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-300">Limited time</span>
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {halloweenPyramids.map((pyramid) => (
          <article class="flex min-w-0 flex-col overflow-hidden rounded-xl border border-border bg-surface-lowest">
            <div class="flex h-48 items-center justify-center border-b border-border bg-black/20 p-4">
              <img src={pyramid.image} alt={pyramid.name} loading="lazy" class="h-full w-full object-contain" />
            </div>
            <div class="flex flex-1 flex-col gap-4 p-5">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h3 class="text-lg font-semibold text-foreground">{pyramid.name}</h3>
                <span class={`shrink-0 rounded-full border px-2.5 py-1 text-xs font-medium ${chanceClasses(pyramid.chance)}`}><span class="number-animation" data-target={pyramid.chance} data-animation="scramble">{pyramid.chance}</span> chance</span>
              </div>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                <div class="rounded-lg border border-border bg-background/50 p-3">
                  <div class="mb-1 flex items-center gap-1.5 text-xs text-muted-foreground"><img src="/stats/speed.png" alt="" class="h-4 w-4 object-contain" /><img src="/stats/strength.png" alt="" class="h-4 w-4 object-contain" />Waters of Nu</div>
                  <div class="text-base font-semibold text-foreground"><span class="number-animation" data-target={pyramid.boost} data-animation="scramble">{pyramid.boost}</span></div>
                  <div class="text-[11px] text-muted-foreground">Training Boost</div>
                </div>
                <div class="rounded-lg border border-border bg-background/50 p-3">
                  <div class="mb-1 flex items-center gap-1.5 text-xs text-muted-foreground"><img src="/currency/candy-corn.png" alt="" class="h-4 w-4 object-contain" />Candy Corn</div>
                  <div class="text-base font-semibold text-foreground"><span class="number-animation" data-target={pyramid.reward} data-animation="scramble">{pyramid.reward}</span></div>
                  <div class="text-[11px] text-muted-foreground">Reward Multiplier</div>
                </div>
                <div class="rounded-lg border border-border bg-background/50 p-3">
                  <div class="mb-1 text-xs text-muted-foreground">Blocks</div>
                  <div class="text-base font-semibold tabular-nums text-foreground"><span class="number-animation" data-target={pyramid.blocks} data-animation="count">{pyramid.blocks}</span></div>
                  <div class="text-[11px] text-muted-foreground">Required</div>
                </div>
              </div>
              <div class="flex items-center justify-between border-t border-border pt-3 text-sm">
                <span class="text-muted-foreground">Pick price</span>
                <span class="font-semibold text-foreground">{pyramid.price === "N/A" ? "N/A" : <span class="number-animation" data-target={pyramid.price} data-animation="scramble">{pyramid.price}</span>}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const animatedNumbers = document.querySelectorAll(".number-animation");

  animatedNumbers.forEach((element) => {
    const target = element.getAttribute("data-target") || "";
    const mode = element.getAttribute("data-animation");
    const match = target.match(/(\d[\d,]*(?:\.\d+)?)/);

    if (!match || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const targetNumber = Number(match[0].replaceAll(",", ""));
    const prefix = target.slice(0, match.index);
    const suffix = target.slice((match.index || 0) + match[0].length);
    const decimals = (match[0].split(".")[1] || "").length;
    const duration = 2000;
    const start = performance.now();
    let lastUpdate = 0;

    const render = (number: number) => {
      const formatted = decimals
        ? number.toFixed(decimals)
        : Math.round(number).toLocaleString("en-US");
      element.textContent = prefix + formatted + suffix;
    };

    const animate = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);

      if (mode === "count") {
        render(targetNumber * eased);
      } else if (progress === 1) {
        element.textContent = target;
      } else {
        const updateInterval = 35 + progress * 260;
        if (now - lastUpdate >= updateInterval) {
          lastUpdate = now;
          const randomValue = Math.random() * Math.max(targetNumber * 1.5, 20);
          render(randomValue);
        }
      }

      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        element.textContent = target;
      }
    };

    requestAnimationFrame(animate);
  });
</script>
