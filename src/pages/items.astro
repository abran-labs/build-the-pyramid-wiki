---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MAX_BANKED_HOURS, POTION_KINDS, bonusText, durationText, potionsFor } from "@/lib/potions";
---

<BaseLayout
  title="Items"
  section="Items"
  description="Potions in Build the Pyramid: Luck, Hatch Speed, and Currency tiers, durations, and how banked time works."
>
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-8 px-4 py-8">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-semibold tracking-[-0.02em] text-foreground">Items</h1>
      <p class="text-sm text-muted-foreground">
        Potions grant temporary boosts. Three kinds exist, five tiers each — higher tiers last longer and hit harder.
      </p>
    </div>
    {
      POTION_KINDS.map((kind) => (
        <section aria-label={kind.name} class="flex flex-col gap-3">
          <div>
            <h2 class="text-lg font-semibold tracking-[-0.01em] text-foreground">{kind.name}</h2>
            <p class="text-sm text-muted-foreground">{kind.blurb}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {potionsFor(kind.id).map((potion) => (
              <article class="flex flex-col gap-3 rounded-lg border border-border bg-surface-lowest p-4">
                <div class="flex items-center gap-3">
                  <img alt="" class="h-16 w-16 shrink-0 object-contain" src={potion.icon} />
                  <div class="min-w-0">
                    <h3 class="truncate text-sm font-semibold text-foreground">{potion.name}</h3>
                    <p class="text-xs text-muted-foreground">{kind.blurb}</p>
                  </div>
                </div>
                <div class="flex items-center justify-between gap-2 text-sm">
                  <span class="text-muted-foreground">Duration</span>
                  <span class="font-semibold text-foreground">{durationText(potion.durationMinutes)}</span>
                </div>
                <div class="flex items-center justify-between gap-2 text-sm">
                  <span class="text-muted-foreground">Bonus</span>
                  <span class="font-semibold text-foreground">{bonusText(potion)}</span>
                </div>
                {potion.luck > 0 && (
                  <p class="text-xs text-muted-foreground">Counts as +{potion.luck} hatch luck.</p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))
    }
    <section aria-label="How potions work" class="flex flex-col gap-3">
      <h2 class="text-lg font-semibold tracking-[-0.01em] text-foreground">How potions work</h2>
      <ul class="list-disc space-y-1 pl-5 text-sm text-muted-foreground">
        <li>
          Get them from the potion stall on the{" "}
          <a class="text-foreground underline-offset-4 hover:underline" href="/black-market">
            Black Market
          </a>{" "}
          — stock rotates every hour.
        </li>
        <li>
          Using a potion banks its time on that tier. Each kind runs its highest tier first; when it runs
          out the next tier down takes over. The order you drink them doesn&apos;t matter.
        </li>
        <li>Time only runs while you&apos;re in a server (AFK counts). It never runs offline and can&apos;t be paused.</li>
        <li>Up to {MAX_BANKED_HOURS} hours banked per kind.</li>
        <li>Manage them from the Potions tab in the pet menu.</li>
      </ul>
    </section>
  </main>
</BaseLayout>
