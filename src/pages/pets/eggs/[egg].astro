---
import { PetCalculator } from "@/components/calculator/pet-calculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { EGGS, slug, type Egg } from "@/lib/pets";

export function getStaticPaths() {
  return EGGS.map((entry) => ({
    params: { egg: slug(entry.id) },
    props: { eggId: entry.id },
  }));
}

interface Props {
  readonly eggId: string;
}

const { eggId } = Astro.props;
const egg: Egg | undefined = EGGS.find((entry) => entry.id === eggId);
if (egg === undefined) throw new Error(`Unknown egg: ${eggId}`);
---

<BaseLayout
  title={`${egg.name} · Pets`}
  section="Pets"
  description={`Every pet in the ${egg.name}: hatch odds, rarities, and the coins and Candy Corn each one drops in Build the Pyramid.`}
  image={egg.icon}
>
  <main class="mx-auto flex w-full max-w-5xl flex-1 items-start justify-center py-4 md:items-center md:py-8">
    <PetCalculator client:load initialBrowseId={egg.id} />
  </main>
</BaseLayout>
