  ] },
  { code: "CURSEDSECRET", rewards: [{ label: "Witch's Pot Pet", image: "/pets/witchs-pot.png", href: "/pets/witchs-pot" }] },
];
---

<BaseLayout
  title="Codes"
  section="Codes"
  description="All known Build the Pyramid codes and their rewards."
>
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-8 px-4 py-8">
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-[-0.02em] text-foreground">Codes</h1>
        <span class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
          {codes.length} codes listed
        </span>
      </div>
    </div>

    <section aria-label="Build the Pyramid codes" class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {codes.map(({ code, rewards }) => (
        <article class="flex flex-col gap-4 rounded-lg border border-border bg-surface-lowest p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex min-w-0 flex-wrap items-center gap-3">
              <h2 class="font-mono text-base font-semibold tracking-wide text-foreground">{code}</h2>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
                <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                Working
              </span>
            </div>
            <button
              type="button"
              data-copy-code={code}
              data-state="idle"
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md border border-border bg-surface px-3 py-2 text-xs font-semibold text-foreground transition-colors hover:border-primary/50 hover:bg-surface-high"
              aria-label={`Copy code ${code}`}
            >
              <span aria-hidden="true" class="copy-icon copy-icon-copy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
                  <rect x="8" y="8" width="12" height="12" rx="2"></rect>
                  <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
                </svg>
              </span>
              <span aria-hidden="true" class="copy-icon copy-icon-check">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path class="copy-check-path" d="M4 12.5 9.5 18 20 6.5"></path>
                </svg>
              </span>
              <span data-copy-label>Copy code</span>
            </button>
          </div>
          <div class="flex flex-col gap-3">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Rewards</span>
            <ul class="flex flex-col gap-2.5 text-sm text-foreground">
              {rewards.map(({ label, image, href }) => (
                <li>
                  {href ? (
                    <a
                      class="group flex items-center gap-3 text-foreground transition-colors duration-150 hover:text-foreground"
                      href={href}
                    >
                      <img src={image} alt="" loading="lazy" class="h-8 w-8 shrink-0 object-contain" />
                      <span class="underline decoration-muted-foreground/60 underline-offset-4 transition-colors duration-150 group-hover:decoration-foreground">
                        {label}
                      </span>
                    </a>
                  ) : (
                    <span class="flex items-center gap-3">
                      <img src={image} alt="" loading="lazy" class="h-8 w-8 shrink-0 object-contain" />
                      <span>{label}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((button) => {
    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      const code = button.dataset.copyCode;
      if (!code) return;

      const fallbackCopy = () => {
        const textarea = document.createElement("textarea");
        textarea.value = code;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        const copied = document.execCommand("copy");
        textarea.remove();
        return copied;
      };

      let copied = false;
      try {
        if (navigator.clipboard?.writeText && window.isSecureContext) {
          await navigator.clipboard.writeText(code);
          copied = true;
        }
      } catch {
        // Fall back for browsers or preview environments that block Clipboard API access.
      }

      if (!copied) {
        try {
          copied = fallbackCopy();
        } catch {
          copied = false;
        }
      }

      if (resetTimer !== undefined) window.clearTimeout(resetTimer);

      const label = button.querySelector<HTMLElement>("[data-copy-label]");

      if (copied) {
        button.dataset.state = "copied";
        if (label !== null) label.textContent = "Copied!";
        button.classList.remove(
          "border-border",
          "bg-surface",
          "text-foreground",
          "hover:border-primary/50",
          "hover:bg-surface-high",
        );
        button.classList.add("border-emerald-500/40", "bg-emerald-500/15", "text-emerald-400");
        button.setAttribute("aria-label", `Copied code ${code}`);
      } else {
        if (label !== null) label.textContent = "Copy failed";
        button.setAttribute("aria-label", `Could not copy code ${code}`);
      }

      resetTimer = window.setTimeout(() => {
        button.dataset.state = "idle";
        if (label !== null) label.textContent = "Copy code";
        button.classList.remove("border-emerald-500/40", "bg-emerald-500/15", "text-emerald-400");
        button.classList.add(
          "border-border",
          "bg-surface",
          "text-foreground",
          "hover:border-primary/50",
          "hover:bg-surface-high",
        );
        button.setAttribute("aria-label", `Copy code ${code}`);
      }, 3000);
    });
  });
</script>

<style>
  [data-copy-code] .copy-icon {
    display: inline-flex;
  }

  [data-copy-code] .copy-icon-check {
    display: none;
  }

  [data-copy-code][data-state="copied"] .copy-icon-copy {
    display: none;
  }

  [data-copy-code][data-state="copied"] .copy-icon-check {
    display: inline-flex;
    animation: copy-check-pop 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  [data-copy-code][data-state="copied"] .copy-check-path {
    stroke-dasharray: 24;
    animation: copy-check-draw 340ms ease-out both;
  }

  @keyframes copy-check-pop {
    0% {
      transform: scale(0.7);
      opacity: 0;
    }
    60% {
      transform: scale(1.08);
      opacity: 1;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes copy-check-draw {
    from {
      stroke-dashoffset: 24;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-copy-code][data-state="copied"] .copy-icon-check,
    [data-copy-code][data-state="copied"] .copy-check-path {
      animation: none;
    }
  }
</style>
