---
import { EggsHatchedLine } from "@/components/calculator/eggs-hatched-line";
import { PetCalculator } from "@/components/calculator/pet-calculator";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pets"
  section="Pets"
  description="Hatch eggs, collect pets, and find out everything about them."
  image="/og/pets.png"
>
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col items-stretch justify-start gap-3 py-4 md:justify-center md:py-8">
    <PetCalculator client:load />
    <EggsHatchedLine client:load />
  </main>
</BaseLayout>
