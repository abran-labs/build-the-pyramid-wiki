---
import BaseLayout from "@/layouts/BaseLayout.astro";

const codes = [
  { code: "MAZERUNNER", rewards: ["35,000 Candy Corn", "3× Luck Potion V", "3× Currency Potion V", "3× Hatch Speed Potion V"] },
  { code: "NEEDMOREBOOST", rewards: ["10× Luck Potion V", "10× Hatch Speed Potion V", "10× Currency Potion V"] },
  { code: "HALLOWEENPART2", rewards: ["10,000 Candy Corn", "Luck Potion V", "Currency Potion V"] },
  { code: "WHATISTHISPLACE", rewards: ["35,000 Candy Corn", "3× Luck Potion V", "3× Currency Potion V", "3× Hatch Speed Potion V"] },
  { code: "UPDATEDELAY3", rewards: ["15,000 Candy Corn", "Luck Potion V", "Hatch Speed Potion V", "Currency Potion V"] },
  { code: "DEADEND", rewards: ["35,000 Candy Corn", "3× Luck Potion V", "3× Currency Potion V", "3× Hatch Speed Potion V"] },
  { code: "PETS", rewards: ["25,000 Coins"] },
  { code: "SORRYFORDELAY", rewards: ["25,000 or 50,000 Coins"] },
  { code: "SECRETSPHINX", rewards: ["50,000 Coins"] },
  { code: "DEADBYMELOL", rewards: ["1 Coin"] },
  { code: "FREECODE", rewards: ["500 Coins"] },
  { code: "WELCOME", rewards: ["500 Speed", "500 Strength"] },
  { code: "JACKVSZED", rewards: ["50,000 Candy Corn", "10,000 Speed", "10,000 Strength"] },
  { code: "HAPPYHALLOWEEN", rewards: ["Skeleton Camel Pet"], petHref: "/pets" },
  { code: "HALLOWEEN", rewards: ["5,000 Candy Corn"] },
  { code: "SECRETBAT", rewards: ["Bat Pet"], petHref: "/pets" },
  { code: "ARISUNA", rewards: ["100,000 Candy Corn", "100,000 Coins"] },
  { code: "CURSEDSECRET", rewards: ["Witch's Pot Pet"], petHref: "/pets" },
] as const;
---

<BaseLayout
  title="Codes"
  section="Codes"
  description="All known Build the Pyramid codes and their rewards."
>
  <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-8 px-4 py-8">
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-[-0.02em] text-foreground">Codes</h1>
        <span class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400">
          {codes.length} codes listed
        </span>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
        Redeem these codes in Build the Pyramid for free rewards. Each code is shown with its current status and the rewards it provides.
      </p>
    </div>

    <section aria-label="Build the Pyramid codes" class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {codes.map(({ code, rewards, petHref }) => (
        <article class="flex flex-col gap-4 rounded-lg border border-border bg-surface-lowest p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-mono text-base font-semibold tracking-wide text-foreground">{code}</h2>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400">
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Working
            </span>
          </div>
          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Rewards</span>
            <ul class="flex flex-col gap-2 text-sm text-foreground">
              {rewards.map((reward) => (
                <li class="flex items-start gap-2">
                  <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
                  {petHref && reward.endsWith("Pet") ? <a class="underline decoration-border underline-offset-4 transition-colors hover:text-primary" href={petHref}>{reward}</a> : <span>{reward}</span>}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </section>
    <p class="text-xs leading-5 text-muted-foreground">
      Code availability and rewards can change after game updates. The Working labels reflect the supplied code list.
    </p>
  </main>
</BaseLayout>
